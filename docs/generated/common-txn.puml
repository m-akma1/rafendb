org.rafendb.common.txn.AccessResult *--  org.rafendb.common.txn.AccessResult$Status : status
org.rafendb.common.txn.ChangeRecord *--  org.rafendb.common.txn.ResourceId : resource
org.rafendb.common.txn.TxResult *--  org.rafendb.common.txn.TxStatus : status


@enduml