	{field} +SYNTAX_ERROR
	{field} +VALID
	{field} +VALIDATION_ERROR
}


class org.rafendb.optimizer.driver.ScenarioResult {
	{method} +actual () : ScenarioOutcome
	{method} +detail () : String
	{method} +passed () : boolean
	{method} +scenario () : TestScenario
}


