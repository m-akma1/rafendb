@startuml

set namespaceSeparator .
hide empty members
skinparam linetype ortho


interface org.rafendb.optimizer.binder.Binder {
	{method}  {abstract} +bind ( parsed : ParsedQuery ) : ParsedQuery
}


class org.rafendb.optimizer.binder.QueryBinder {
	{method} +bind ( parsed : ParsedQuery ) : ParsedQuery
	{method} +bind ( query : SelectQuery ) : SelectQuery
}


class org.rafendb.optimizer.catalog.CachingCatalog {
	{method} +getSchema ( table : String ) : TableSchema
	{method} +listIndexes ( table : String ) : List
	{method} +listTables () : List
}


interface org.rafendb.optimizer.catalog.Catalog {
	{method}  {abstract} +getSchema ( table : String ) : TableSchema
	{method}  {abstract} +getStats ( table : String ) : TableStats
	{method}  {abstract} +listIndexes ( table : String ) : List
	{method}  {abstract} +listTables () : List
}


class org.rafendb.optimizer.catalog.StorageManagerCatalog {
	{method} +getSchema ( table : String ) : TableSchema
	{method} +getStats ( table : String ) : TableStats
	{method} +listIndexes ( table : String ) : List
	{method} +listTables () : List
}


class org.rafendb.optimizer.cost.Cost {
	{field} {static} +SEEK_MILLIS : double
	{field} {static} +TRANSFER_MILLIS : double
	{method} +plus ( other : Cost ) : Cost
	{method} +timeMs () : double
}


interface org.rafendb.optimizer.cost.CostModel {
	{method}  {abstract} +estimateLocalCost ( node : PlanNode ) : Cost
	{method}  {abstract} +estimateRows ( node : PlanNode ) : long
	{method} +estimateTotalCost ( node : PlanNode ) : Cost
	{method} +getCost ( root : PlanNode ) : double
}


class org.rafendb.optimizer.cost.CostParameters {
	{method} +blockSizeBytes () : int
	{method} +bufferBlocks () : int
	{method} +defaultEqSelectivity () : double
	{method}  {static} +defaults () : CostParameters
	{method} +rangeSelectivity () : double
	{method} +seekMillis () : double
	{method} +transferMillis () : double
}


class org.rafendb.optimizer.cost.StatsCostModel {
	{method} +estimateLocalCost ( node : PlanNode ) : Cost
	{method} +estimateRows ( node : PlanNode ) : long
	{method} +estimateTotalCost ( node : PlanNode ) : Cost
}


class org.rafendb.optimizer.join.AccessPathOptimizer {
	{method} +generateCandidates ( root : PlanNode ) : List
}


class org.rafendb.optimizer.join.JoinAccessPathOptimizer {
	{method} +optimize ( plan : QueryPlan ) : QueryPlan
}


class org.rafendb.optimizer.join.JoinAccessPathOptimizer$SearchConfig {
	{method} +accessPathBudget () : int
	{method}  {static} +defaults () : SearchConfig
	{method} +generations () : int
	{method} +mode () : SearchMode
	{method} +mutationProbability () : double
	{method} +populationSize () : int
	{method} +seed () : long
}


enum org.rafendb.optimizer.join.JoinAccessPathOptimizer$SearchMode {
	{field} +GENETIC
	{field} +HEURISTIC
}


class org.rafendb.optimizer.join.JoinOptimizer {
	{method} +generateCandidates ( root : PlanNode , storage : StorageManager ) : List
	{method} +normalize ( root : PlanNode ) : PlanNode
}


interface org.rafendb.optimizer.lexer.Tokenizer {
	{method}  {abstract} +tokenize ( Sql : String ) : List
}


class org.rafendb.optimizer.lexer.TokenizerImpl {
	{method} +tokenize ( sql : String ) : List
}


class org.rafendb.optimizer.parser.QueryParser {
	{method} +parse ( sql : String ) : ParsedQuery
}


class org.rafendb.optimizer.rewrite.ProjectionPushdownRule {
	{method} +apply ( root : PlanNode ) : PlanNode
}


interface org.rafendb.optimizer.rewrite.RewriteRule {
	{method}  {abstract} +apply ( node : PlanNode ) : PlanNode
}


class org.rafendb.optimizer.rewrite.SelectionPushdownRule {
	{field} {static} +KEEP_ORDER : Comparator
	{field} {static} +SELECTIVE_FIRST : Comparator
	{method} +apply ( root : PlanNode ) : PlanNode
}




org.rafendb.optimizer.binder.QueryBinder *--  org.rafendb.optimizer.catalog.Catalog : catalog
org.rafendb.optimizer.binder.QueryBinder ..|>  org.rafendb.optimizer.binder.Binder
org.rafendb.optimizer.catalog.CachingCatalog *--  org.rafendb.optimizer.catalog.Catalog : delegate
org.rafendb.optimizer.catalog.CachingCatalog ..|>  org.rafendb.optimizer.catalog.Catalog
org.rafendb.optimizer.catalog.StorageManagerCatalog ..|>  org.rafendb.optimizer.catalog.Catalog
org.rafendb.optimizer.cost.StatsCostModel *--  org.rafendb.optimizer.catalog.Catalog : catalog
org.rafendb.optimizer.cost.StatsCostModel *--  org.rafendb.optimizer.cost.CostParameters : parameters
org.rafendb.optimizer.cost.StatsCostModel ..|>  org.rafendb.optimizer.cost.CostModel
org.rafendb.optimizer.join.JoinAccessPathOptimizer *--  org.rafendb.optimizer.cost.CostModel : costs
org.rafendb.optimizer.join.JoinAccessPathOptimizer *--  org.rafendb.optimizer.join.AccessPathOptimizer : access
org.rafendb.optimizer.join.JoinAccessPathOptimizer *--  org.rafendb.optimizer.join.JoinAccessPathOptimizer$SearchConfig : config
org.rafendb.optimizer.join.JoinAccessPathOptimizer *--  org.rafendb.optimizer.join.JoinOptimizer : joins
org.rafendb.optimizer.join.JoinAccessPathOptimizer$SearchConfig *--  org.rafendb.optimizer.join.JoinAccessPathOptimizer$SearchMode : mode
org.rafendb.optimizer.lexer.TokenizerImpl ..|>  org.rafendb.optimizer.lexer.Tokenizer
org.rafendb.optimizer.parser.QueryParser *--  org.rafendb.optimizer.lexer.Tokenizer : tokenizer
org.rafendb.optimizer.rewrite.ProjectionPushdownRule ..|>  org.rafendb.optimizer.rewrite.RewriteRule
org.rafendb.optimizer.rewrite.SelectionPushdownRule ..|>  org.rafendb.optimizer.rewrite.RewriteRule


@enduml