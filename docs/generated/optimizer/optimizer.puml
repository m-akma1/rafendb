@startuml

set namespaceSeparator .
hide empty members
skinparam linetype ortho


class org.rafendb.optimizer.QueryOptimizerImpl {
	{method} +explain ( plan : QueryPlan ) : String
	{method} +optimize ( bound : ParsedQuery ) : QueryPlan
	{method} +parse ( sql : String ) : ParsedQuery
}


