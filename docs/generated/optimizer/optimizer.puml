org.rafendb.optimizer.cost.StatsCostModel ..|>  org.rafendb.optimizer.cost.CostModel
org.rafendb.optimizer.driver.OptimizerDriver -->  org.rafendb.optimizer.driver.ScenarioRunner : runner
org.rafendb.optimizer.driver.ScenarioResult *--  org.rafendb.optimizer.driver.ScenarioOutcome : actual
org.rafendb.optimizer.driver.ScenarioResult *--  org.rafendb.optimizer.driver.TestScenario : scenario
org.rafendb.optimizer.driver.ScenarioRunner *--  org.rafendb.optimizer.binder.QueryBinder : binder
org.rafendb.optimizer.driver.ScenarioRunner *--  org.rafendb.optimizer.join.JoinAccessPathOptimizer : optimizer
org.rafendb.optimizer.driver.ScenarioRunner *--  org.rafendb.optimizer.parser.QueryParser : parser
org.rafendb.optimizer.driver.ScenarioRunner *--  org.rafendb.optimizer.plan.InitialPlanBuilder : planBuilder
org.rafendb.optimizer.driver.TestScenario *--  org.rafendb.optimizer.driver.ScenarioOutcome : expected
org.rafendb.optimizer.join.JoinAccessPathOptimizer *--  org.rafendb.optimizer.cost.CostModel : costs
org.rafendb.optimizer.join.JoinAccessPathOptimizer *--  org.rafendb.optimizer.join.AccessPathOptimizer : access
org.rafendb.optimizer.join.JoinAccessPathOptimizer *--  org.rafendb.optimizer.join.JoinAccessPathOptimizer$SearchConfig : config
org.rafendb.optimizer.join.JoinAccessPathOptimizer *--  org.rafendb.optimizer.join.JoinOptimizer : joins
org.rafendb.optimizer.join.JoinAccessPathOptimizer$SearchConfig *--  org.rafendb.optimizer.join.JoinAccessPathOptimizer$SearchMode : mode
org.rafendb.optimizer.lexer.TokenizerImpl ..|>  org.rafendb.optimizer.lexer.Tokenizer
org.rafendb.optimizer.parser.QueryParser *--  org.rafendb.optimizer.lexer.Tokenizer : tokenizer
org.rafendb.optimizer.plan.InitialPlanBuilder *--  org.rafendb.optimizer.cost.CostModel : model
