org.rafendb.optimizer.QueryOptimizerImpl *--  org.rafendb.optimizer.binder.QueryBinder : binder
org.rafendb.optimizer.QueryOptimizerImpl *--  org.rafendb.optimizer.join.JoinAccessPathOptimizer : optimizer
org.rafendb.optimizer.QueryOptimizerImpl *--  org.rafendb.optimizer.parser.QueryParser : parser
org.rafendb.optimizer.QueryOptimizerImpl *--  org.rafendb.optimizer.plan.InitialPlanBuilder : planBuilder
org.rafendb.optimizer.QueryOptimizerImpl *--  org.rafendb.optimizer.rewrite.PlanRewriter : rewriter
org.rafendb.optimizer.binder.QueryBinder *--  org.rafendb.optimizer.catalog.Catalog : catalog
org.rafendb.optimizer.binder.QueryBinder ..|>  org.rafendb.optimizer.binder.Binder
