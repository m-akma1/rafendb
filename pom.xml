<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.rafendb</groupId>
  <artifactId>rafendb</artifactId>
  <!-- Set for each release. Local builds are x.y.z-dev-SNAPSHOT -->
  <version>${revision}</version>
  <packaging>jar</packaging>

  <name>RafenDB</name>
  <description>mini Database Management System from scratch. Made for IF3140 Database System Sem 1 2026/2027</description>

  <properties>
    <revision>0.1.0-dev-SNAPSHOT</revision>

    <!-- Language level. javac checks against the Java 25 API even on a newer JDK. -->
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Test library: any JUnit 6 is fine-->
    <junit.version>6.1.3</junit.version>

    <!-- Formatter. Pinned explicitly so a plugin upgrade never reformats the codebase. -->
    <spotless.version>3.10.4</spotless.version>
    <google-java-format.version>1.36.1</google-java-format.version>

    <!-- Every Maven plugin pinned, so Maven 3.9 and 3.10 build identically. -->
    <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
    <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>
    <maven-site-plugin.version>3.22.0</maven-site-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <maven-wrapper-plugin.version>3.3.4</maven-wrapper-plugin.version>
    <plantuml-generator-maven-plugin.version>3.0.1</plantuml-generator-maven-plugin.version>
    <!-- Bundles PlantUML 1.2025.0. Don't override it: newer PlantUML breaks this plugin without any error. -->
    <plantuml-maven-plugin.version>0.2.13</plantuml-maven-plugin.version>

    <!-- Where -Pdiagrams writes the class diagrams (.puml, .svg, .png). -->
    <diagrams.outputDirectory>${project.basedir}/docs/generated</diagrams.outputDirectory>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- The BOM keeps all JUnit artifacts on one version. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Test scope only. Main code has zero dependencies, the enforcer checks this. -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Stable name, so scripts/run.sh always finds target/rafendb.jar. -->
    <finalName>rafendb</finalName>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven-clean-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <showWarnings>true</showWarnings>
            <!-- Keep parameter names in bytecode, so generated diagrams show real names. -->
            <parameters>true</parameters>
            <compilerArgs>
              <!-- All lint warnings visible, none fatal. -->
              <arg>-Xlint:all</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
          <configuration>
            <archive>
              <manifest>
                <!-- java -jar target/rafendb.jar starts the server. -->
                <mainClass>org.rafendb.server.ServerMain</mainClass>
                <!-- Writes Implementation-Version, which Version.current() prints in banners. -->
                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
              </manifest>
            </archive>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${maven-deploy-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>${maven-site-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-wrapper-plugin</artifactId>
          <version>${maven-wrapper-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
        </plugin>
        <plugin>
          <groupId>de.elnarion.maven</groupId>
          <artifactId>plantuml-generator-maven-plugin</artifactId>
          <version>${plantuml-generator-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>com.github.davidmoten</groupId>
          <artifactId>plantuml-maven-plugin</artifactId>
          <version>${plantuml-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Fails fast, with a readable message, before anything compiles. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-toolchain-and-spec-rules</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                  <message>RafenDB needs JDK 25 or newer. Point JAVA_HOME at a JDK 25 install.</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                  <message>Maven 3.9 or newer is required. Use ./mvnw, which downloads the right version.</message>
                </requireMavenVersion>
                <requirePluginVersions>
                  <message>Pin every plugin version in pluginManagement.</message>
                </requirePluginVersions>
                <bannedDependencies>
                  <excludes>
                    <exclude>*:*:*:*:compile</exclude>
                    <exclude>*:*:*:*:runtime</exclude>
                    <exclude>*:*:*:*:provided</exclude>
                    <exclude>*:*:*:*:system</exclude>
                  </excludes>
                  <message>Only test-scope dependencies are allowed. RafenDB uses the JDK only.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Formatting: apply on every local build, check in CI (CI passes -Dspotless.apply.skip=true). -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
              <!-- AOSP with 4-space indent-->
              <style>AOSP</style>
              <!-- Leave hand-written Javadoc (contract docs). -->
              <formatJavadoc>false</formatJavadoc>
            </googleJavaFormat>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>format</id>
            <phase>process-sources</phase>
            <goals>
              <goal>apply</goal>
            </goals>
          </execution>
          <execution>
            <id>check-format</id>
            <!-- Default phase: verify. -->
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Class diagrams of the module contracts (api.*) and shared types (common).
      Run: ./mvnw -Pdiagrams process-classes
      Writes .puml, .svg and .png per diagram to docs/generated. Rendering needs Graphviz (dot) on PATH.
    -->
    <profile>
      <id>diagrams</id>
      <build>
        <plugins>
          <plugin>
            <groupId>de.elnarion.maven</groupId>
            <artifactId>plantuml-generator-maven-plugin</artifactId>
            <configuration>
              <outputDirectory>${diagrams.outputDirectory}</outputDirectory>
              <!-- Public contract only: drops private helpers, serialVersionUID and record backing fields. -->
              <maxVisibilityFields>PUBLIC</maxVisibilityFields>
              <maxVisibilityMethods>PUBLIC</maxVisibilityMethods>
              <!-- Boilerplate every record has. Record components still show as accessors. -->
              <methodBlacklistRegexp>equals|hashCode|toString</methodBlacklistRegexp>
              <!-- Package boxes keep full names; members use short type names. -->
              <useShortClassNamesInFieldsAndMethods>true</useShortClassNamesInFieldsAndMethods>
              <additionalPlantUmlConfigs>
                <additionalPlantUmlConfig>set namespaceSeparator .</additionalPlantUmlConfig>
                <additionalPlantUmlConfig>hide empty members</additionalPlantUmlConfig>
                <additionalPlantUmlConfig>skinparam linetype ortho</additionalPlantUmlConfig>
              </additionalPlantUmlConfigs>
            </configuration>
            <executions>
              <!-- Classes must be compiled first, so every execution runs at process-classes. -->
              <!-- Cross-component view: every api.* contract in one diagram. -->
              <execution>
                <id>api</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <outputFilename>api.puml</outputFilename>
                  <scanPackages>
                    <scanPackage>org.rafendb.api</scanPackage>
                  </scanPackages>
                </configuration>
              </execution>
              <!-- Same, plus the shared types the contracts exchange. -->
              <execution>
                <id>api-with-common</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <outputFilename>api-with-common.puml</outputFilename>
                  <scanPackages>
                    <scanPackage>org.rafendb.api</scanPackage>
                    <scanPackage>org.rafendb.common</scanPackage>
                  </scanPackages>
                </configuration>
              </execution>
              <!-- Per-component views. -->
              <execution>
                <id>api-storage</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <outputFilename>api-storage.puml</outputFilename>
                  <scanPackages>
                    <scanPackage>org.rafendb.api.storage</scanPackage>
                  </scanPackages>
                </configuration>
              </execution>
              <execution>
                <id>api-concurrency</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <outputFilename>api-concurrency.puml</outputFilename>
                  <scanPackages>
                    <scanPackage>org.rafendb.api.concurrency</scanPackage>
                  </scanPackages>
                </configuration>
              </execution>
              <execution>
                <id>api-optimizer</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <outputFilename>api-optimizer.puml</outputFilename>
                  <scanPackages>
                    <scanPackage>org.rafendb.api.optimizer</scanPackage>
                  </scanPackages>
                </configuration>
              </execution>
              <execution>
                <id>api-processor</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <outputFilename>api-processor.puml</outputFilename>
                  <scanPackages>
                    <scanPackage>org.rafendb.api.processor</scanPackage>
                  </scanPackages>
                </configuration>
              </execution>
              <execution>
                <id>api-recovery</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <outputFilename>api-recovery.puml</outputFilename>
                  <scanPackages>
                    <scanPackage>org.rafendb.api.recovery</scanPackage>
                  </scanPackages>
                </configuration>
              </execution>
              <execution>
                <id>common</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <outputFilename>common.puml</outputFilename>
                  <scanPackages>
                    <scanPackage>org.rafendb.common</scanPackage>
                  </scanPackages>
                </configuration>
              </execution>
              <!-- Per-subpackage views of common, since the full one is too long to read. -->
              <execution>
                <id>common-error</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <outputFilename>common-error.puml</outputFilename>
                  <scanPackages>
                    <scanPackage>org.rafendb.common.error</scanPackage>
                  </scanPackages>
                </configuration>
              </execution>
              <execution>
                <id>common-expr</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <outputFilename>common-expr.puml</outputFilename>
                  <scanPackages>
                    <scanPackage>org.rafendb.common.expr</scanPackage>
                  </scanPackages>
                </configuration>
              </execution>
              <execution>
                <id>common-log</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <outputFilename>common-log.puml</outputFilename>
                  <scanPackages>
                    <scanPackage>org.rafendb.common.log</scanPackage>
                  </scanPackages>
                </configuration>
              </execution>
              <execution>
                <id>common-plan</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <outputFilename>common-plan.puml</outputFilename>
                  <scanPackages>
                    <scanPackage>org.rafendb.common.plan</scanPackage>
                  </scanPackages>
                </configuration>
              </execution>
              <execution>
                <id>common-query</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <outputFilename>common-query.puml</outputFilename>
                  <scanPackages>
                    <scanPackage>org.rafendb.common.query</scanPackage>
                  </scanPackages>
                </configuration>
              </execution>
              <execution>
                <id>common-schema</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <outputFilename>common-schema.puml</outputFilename>
                  <scanPackages>
                    <scanPackage>org.rafendb.common.schema</scanPackage>
                  </scanPackages>
                </configuration>
              </execution>
              <execution>
                <id>common-tuple</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <outputFilename>common-tuple.puml</outputFilename>
                  <scanPackages>
                    <scanPackage>org.rafendb.common.tuple</scanPackage>
                  </scanPackages>
                </configuration>
              </execution>
              <execution>
                <id>common-txn</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <outputFilename>common-txn.puml</outputFilename>
                  <scanPackages>
                    <scanPackage>org.rafendb.common.txn</scanPackage>
                  </scanPackages>
                </configuration>
              </execution>
              <execution>
                <id>common-type</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <outputFilename>common-type.puml</outputFilename>
                  <scanPackages>
                    <scanPackage>org.rafendb.common.type</scanPackage>
                  </scanPackages>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <!-- Renders the .puml files above to images. Same phase, declared after, so it runs after them. -->
          <plugin>
            <groupId>com.github.davidmoten</groupId>
            <artifactId>plantuml-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>render-diagrams</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <sources>
                    <directory>${diagrams.outputDirectory}</directory>
                    <includes>
                      <include>*.puml</include>
                    </includes>
                  </sources>
                  <outputDirectory>${diagrams.outputDirectory}</outputDirectory>
                  <formats>
                    <format>svg</format>
                    <format>png</format>
                  </formats>
                  <!-- No embedded source/version metadata, so images only change when the diagram does. -->
                  <metadata>false</metadata>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
