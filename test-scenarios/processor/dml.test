# QP-07, QP-10, QP-11: INSERT, UPDATE and DELETE report how many rows they changed,
# and later queries see the change.

statement count 1
INSERT INTO customers VALUES (61, 'New', 1.5, 'A');

# INSERT values may be expressions; INTEGER * FLOAT gives FLOAT.
statement count 1
INSERT INTO customers VALUES (60 + 2, 'Sum', 2 * 1.5, 'I');

query rowsort
SELECT * FROM customers WHERE customer_id > 60;
----
61 | New | 1.5 | A
62 | Sum | 3.0 | I

# A value that doesn't fit the column is rejected, and nothing is inserted.
statement error
INSERT INTO customers VALUES (63, NULL, 1.0, 'A');

# 30 even customers from the sample, plus 61.
statement count 31
UPDATE customers SET credit = 0 WHERE status = 'A';

query rowsort
SELECT customer_id, credit FROM customers WHERE customer_id < 5;
----
1 | 51.5
2 | 0.0
3 | 54.5
4 | 0.0

# SET may use the row's own value.
statement count 2
UPDATE orders SET amount = amount * 2 WHERE order_id < 3;

query rowsort
SELECT order_id, amount FROM orders WHERE order_id < 4;
----
1 | 22.0
2 | 24.0
3 | 13.0

statement count 20
DELETE FROM order_items WHERE gift = 'Y';

# Without WHERE every remaining row goes.
statement count 40
DELETE FROM order_items;

query
SELECT * FROM order_items;
