# QP-15 and QP-16 bonuses: LIMIT, AS, CREATE/DROP TABLE, and subqueries in WHERE.

query
SELECT order_id FROM orders ORDER BY order_id DESC LIMIT 3;
----
60
59
58

query
SELECT * FROM orders LIMIT 0;

query
SELECT c.name FROM customers AS c WHERE c.customer_id = 3;
----
Customer 3

# CREATE TABLE, use it, then DROP it.
statement ok
CREATE TABLE pets (id INTEGER PRIMARY KEY, owner INTEGER, name VARCHAR(20),
  FOREIGN KEY (owner) REFERENCES customers (customer_id));

statement count 1
INSERT INTO pets VALUES (1, 7, 'Rex');

query
SELECT pets.name, customers.name FROM pets JOIN customers ON pets.owner = customers.customer_id;
----
Rex | Customer 7

statement error
CREATE TABLE pets (id INTEGER PRIMARY KEY);

# orders references customers, so dropping customers needs CASCADE.
statement error
DROP TABLE customers;

# DDL cannot be rolled back, so it is refused inside a transaction.
statement ok
BEGIN;

statement error
DROP TABLE pets;

statement ok
ABORT;

statement ok
DROP TABLE pets;

statement error
SELECT * FROM pets;

# Subqueries: amount = 10 + i, so amount > 68 means orders 59 and 60.
query rowsort
SELECT customer_id FROM customers
  WHERE customer_id IN (SELECT customer_id FROM orders WHERE amount > 68);
----
59
60

query
SELECT customer_id FROM customers
  WHERE NOT customer_id IN (SELECT customer_id FROM orders WHERE amount > 10);

# Correlated: orders with a gift item (items 3, 6, 9 among the first ten).
query rowsort
SELECT o.order_id FROM orders AS o WHERE EXISTS (SELECT * FROM order_items AS i
  WHERE i.order_id = o.order_id AND i.gift = 'Y') AND o.order_id < 10;
----
3
6
9

query
SELECT order_id FROM orders WHERE amount = (SELECT amount FROM orders WHERE order_id = 3);
----
3

statement error
SELECT order_id FROM orders WHERE amount = (SELECT amount FROM orders WHERE order_id > 3);
