package org.rafendb.optimizer.parser;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.junit.jupiter.api.Assertions.assertTrue;

import org.junit.jupiter.api.Test;
import org.rafendb.common.error.SyntaxException;
import org.rafendb.common.expr.Expr;
import org.rafendb.common.expr.Expr.Binary;
import org.rafendb.common.expr.Expr.ColumnRef;
import org.rafendb.common.expr.Expr.Literal;
import org.rafendb.common.expr.Expr.Op;
import org.rafendb.common.type.DataType;
import org.rafendb.common.type.Value;

class ExpressionParserTest {
    private static ExpressionParser parser(String sql) {
        return new ExpressionParser(new TokenCursor(TestTokens.lex(sql)));
    }

    private static Expr condition(String sql) {
        return parser(sql).parseCondition();
    }

    private static Literal i(int v) {
        return new Literal(Value.ofInt(v));
    }

    private static Literal f(float v) {
        return new Literal(Value.ofFloat(v));
    }

    private static Literal s(String v) {
        return new Literal(Value.ofText(DataType.VARCHAR, v));
    }

    private static ColumnRef c(String column) {
        return new ColumnRef(null, column);
    }

    private static Binary bin(Op op, Expr left, Expr right) {
        return new Binary(op, left, right);
    }

    private static void assertSyntaxError(String sql, String messagePart) {
        SyntaxException e = assertThrows(SyntaxException.class, () -> condition(sql));
        assertTrue(e.getMessage().contains(messagePart), e.getMessage());
        assertTrue(e.getPosition() != null, "error must carry a position");
    }

    @Test
    void multiplicationBindsTighterThanAddition() {
        assertEquals(bin(Op.ADD, i(5), bin(Op.MUL, i(3), i(2))), condition("5 + 3 * 2"));
    }

    @Test
    void subtractionIsLeftAssociative() {
        assertEquals(bin(Op.SUB, bin(Op.SUB, i(5), i(3)), i(2)), condition("5 - 3 - 2"));
    }

    @Test
    void parenthesesOverridePrecedence() {
        assertEquals(bin(Op.MUL, bin(Op.ADD, c("a"), c("b")), c("c")), condition("(a + b) * c"));
    }

    @Test
    void arithmeticBindsTighterThanComparison() {
        assertEquals(
                bin(Op.GT, bin(Op.MUL, c("salary"), f(1.05f)), i(5000)),
                condition("salary * 1.05 > 5000"));
    }

    @Test
    void qualifiedColumnsOnBothSides() {
        assertEquals(
                bin(Op.EQ, new ColumnRef("a", "id"), new ColumnRef("b", "aid")),
                condition("a.id = b.aid"));
    }

    @Test
    void notEqualAcceptsBothSpellings() {
        assertEquals(bin(Op.NE, c("a"), i(1)), condition("a <> 1"));
        assertEquals(bin(Op.NE, c("a"), i(1)), condition("a != 1"));
    }

    @Test
    void andChainIsLeftNested() {
        Expr expected =
                bin(
                        Op.AND,
                        bin(Op.AND, bin(Op.GT, c("a"), i(1)), bin(Op.LT, c("b"), i(2))),
                        bin(Op.EQ, c("c"), i(3)));
        assertEquals(expected, condition("a > 1 AND b < 2 AND c = 3"));
    }

    @Test
    void minusBeforeNumberIsNegativeLiteral() {
        assertEquals(bin(Op.SUB, i(5), i(-3)), condition("5 - -3"));
    }

    @Test
    void stringLiteralIsNeverAnOperator() {
        assertEquals(bin(Op.EQ, c("name"), s("+")), condition("name = '+'"));
    }

    @Test
    void setValueIsArithmeticOnly() {
        assertEquals(bin(Op.MUL, f(1.05f), c("salary")), parser("1.05 * salary").parseValue());
    }

    @Test
    void missingRightOperandIsRejected() {
        assertSyntaxError("a >", "end of input");
    }

    @Test
    void operatorWithoutOperandIsRejected() {
        assertSyntaxError("a + * b > 1", "'*'");
    }

    @Test
    void unbalancedParenthesisIsRejected() {
        assertSyntaxError("(a + b > 1", "')'");
    }

    @Test
    void outOfRangeIntegerIsRejected() {
        assertSyntaxError("a > 99999999999", "out-of-range");
    }
}